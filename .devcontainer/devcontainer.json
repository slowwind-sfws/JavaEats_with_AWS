{
    "name": "JavaEats_with_AWS",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "workspaceFolder": "/workspaces/JavaEats_with_AWS",
    "features": {
        "ghcr.io/devcontainers/features/node:2": {
            "version": "22.22.2"
        },
        "ghcr.io/devcontainers/features/java:1": {
             "version": "21",
             "installMaven": true
        },
        "ghcr.io/devcontainers/features/aws-cli:1": {},
        "ghcr.io/audacioustux/devcontainers/aws-sam-cli:1": {},
        "ghcr.io/devcontainers/features/docker-in-docker:3.0.0": {}
    },
    "postCreateCommand": "bash ${containerWorkspaceFolder}/.devcontainer/install.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "vmware.vscode-boot-dev-pack",
                "saoudrizwan.claude-dev"
            ]
        }
    } //,
    //"postStartCommand": "sudo /usr/local/share/docker-init.sh"
}
