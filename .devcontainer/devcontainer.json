{
    "name": "java-sandbox",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "workspaceFolder": "/workspaces/java-sandbox",
    "features": {
         "ghcr.io/devcontainers/features/java:1": {
             "version": "21",
             "installMaven": true
         },
         "ghcr.io/devcontainers/features/aws-cli:1": {},
         "ghcr.io/audacioustux/devcontainers/aws-sam-cli:1": {},
         "ghcr.io/devcontainers/features/docker-in-docker:3.0.0": {}
    },
    "postCreateCommand": "bash ${containerWorkspaceFolder}/.devcontainer/install.sh"//,
    //"postStartCommand": "sudo /usr/local/share/docker-init.sh"
}